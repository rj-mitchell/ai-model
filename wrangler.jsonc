{
  // Deploys the site as a Cloudflare Worker serving static assets: `npx wrangler deploy`.
  // The build (build.js) writes dist/: the pages with every number filled in, plus data.json, data.csv,
  // model.json, llms.txt, robots.txt and sitemap.xml, so the site is machine readable.
  "name": "ai-transformation-model",
  "compatibility_date": "2026-11-01",
  "build": { "command": "node build.js" },
  "assets": { "directory": "./dist", "html_handling": "auto-trailing-slash", "not_found_handling": "404-page" }
}
